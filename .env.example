# Demo traka na vrhu sajta i "demo" ponašanje forme (upit se ne šalje firmi).
# Postavite na "false" kad firma odobri sajt.
NEXT_PUBLIC_DEMO=true

# Slanje upita na email firme preko Resend-a (https://resend.com).
# Bez ovih vrednosti upit se samo pripremi i prikaže kupcu, ništa se ne šalje.
RESEND_API_KEY=
INQUIRY_TO=s.v.samovar@gmail.com
INQUIRY_FROM=SamoVar sajt <upit@samovar.rs>

# Adresa sajta, za metapodatke i sitemap
NEXT_PUBLIC_SITE_URL=https://samovar.rs
